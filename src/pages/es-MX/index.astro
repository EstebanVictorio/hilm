---
import cn from 'clsx'
import Home from '../../layouts/Home.astro';

const TW_UTILS = {
  container: cn("gap-6 px-6 py-8 sm:px-12 sm:py-12 lg:px-20")
}
---

<Home title="Cómo aprendí matemáticas" author="por Esteban Victorio" role="Creador de cosas en tecnología">
  <div class={`flex ${TW_UTILS.container}`}>
    <p class="text-2xl flex flex-col">
      <span>Sobre como aprendí (y sigo aprendiendo)</span>
      <span>sobre matemáticas en general.</span>
    </p>
    <figure>
      <img />
      <figcaption></figcaption>
    </figure>
  </div>
</Home>